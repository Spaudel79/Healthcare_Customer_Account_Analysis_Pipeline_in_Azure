{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "datset_for_dataflow_json_source",
						"type": "DatasetReference"
					},
					"name": "Salesjson"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dataset_sink_for_dataflow",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "derivedColumnForValue3andcategory"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				},
				{
					"name": "selectforsalesID"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sortbasedonSaleID"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as double,",
				"          ProductID as short,",
				"          Quantity as short,",
				"          SaleDate as date,",
				"          SaleID as double,",
				"          TotalAmount as double,",
				"          amount as double,",
				"          category as short,",
				"          date as date,",
				"          id as double,",
				"          value1 as double,",
				"          value2 as short,",
				"          value3 as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments') ~> Salesjson",
				"Salesjson split(!isNull(SaleID),",
				"     disjoint: false) ~> split1@(DatawithSalesID, DatawithID)",
				"select1 derive(Quantity = iif(isNull(Quantity_30), iif(isNull(Quantity_60), Quantity_73, Quantity_60), Quantity_30)) ~> derivedColumnForValue3andcategory",
				"split1@DatawithID select(mapColumn(",
				"          SaleID = id,",
				"          CustomerID = value1,",
				"          ProductID = value2,",
				"          SaleDate = date,",
				"          Quantity_30 = Quantity,",
				"          Quantity_60 = value3,",
				"          Quantity_73 = category,",
				"          TotalAmount = amount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumnForValue3andcategory select(mapColumn(",
				"          SaleID,",
				"          CustomerID,",
				"          ProductID,",
				"          SaleDate,",
				"          Quantity,",
				"          TotalAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, selectforsalesID union(byName: true)~> union1",
				"split1@DatawithSalesID select(mapColumn(",
				"          CustomerID,",
				"          ProductID,",
				"          Quantity,",
				"          SaleDate,",
				"          SaleID,",
				"          TotalAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectforsalesID",
				"union1 aggregate(groupBy(SaleID),",
				"     each(match(name!= 'SaleID'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sort(asc(SaleID, true)) ~> sortbasedonSaleID",
				"selectforsalesID sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {[} as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}