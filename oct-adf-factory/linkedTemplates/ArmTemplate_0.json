			"properties": {
				"type": "Flowlet",
				"typeProperties": {
					"sources": [],
					"sinks": [],
					"transformations": [
						{
							"name": "splitSalesID"
						},
						{
							"name": "input1"
						},
						{
							"name": "output1"
						}
					],
					"scriptLines": [
						"input(output(",
						"          SaleID as double,",
						"          CustomerID as double,",
						"          ProductID as integer,",
						"          SaleDate as string,",
						"          Quantity as integer,",
						"          TotalAmount as double",
						"     ),",
						"     order: 0,",
						"     allowSchemaDrift: true) ~> input1",
						"input1 split(!isNull(SaleID),",
						"     disjoint: false) ~> splitSalesID@(DatawithSalesID, DatawithjustID)",
						"splitSalesID@DatawithSalesID output() ~> output1"
					]
				}
			},
			"dependsOn": []
		},
