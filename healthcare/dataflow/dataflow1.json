{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "datset_for_dataflow_json_source",
						"type": "DatasetReference"
					},
					"name": "Salesjson"
				},
				{
					"dataset": {
						"referenceName": "dataset_soruce_products_adls",
						"type": "DatasetReference"
					},
					"name": "Productssource1"
				},
				{
					"dataset": {
						"referenceName": "dataset_source_customers_adls",
						"type": "DatasetReference"
					},
					"name": "Customers"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "dataset_sink_sqldb",
						"type": "DatasetReference"
					},
					"name": "Finalsink"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "derivedColumnForValue3andcategory"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				},
				{
					"name": "selectforsalesID"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sortbasedonSaleID"
				},
				{
					"name": "RemovingNUll"
				},
				{
					"name": "filterrowexists"
				},
				{
					"name": "checkNullproduct"
				},
				{
					"name": "window1"
				},
				{
					"name": "rankbyQuantity"
				},
				{
					"name": "FinalJOin"
				},
				{
					"name": "removingduplicates"
				},
				{
					"name": "filteronlyexistingcustomers"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as double,",
				"          ProductID as short,",
				"          Quantity as short,",
				"          SaleDate as date,",
				"          SaleID as double,",
				"          TotalAmount as double,",
				"          amount as double,",
				"          category as short,",
				"          date as date,",
				"          id as double,",
				"          value1 as double,",
				"          value2 as short,",
				"          value3 as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments') ~> Salesjson",
				"source(output(",
				"          ProductID as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as string,",
				"          StockQuantity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Productssource1",
				"source(output(",
				"          CustomerID as string,",
				"          CustomerName as string,",
				"          Email as string,",
				"          Phone as string,",
				"          City as string,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Customers",
				"Salesjson split(!isNull(SaleID),",
				"     disjoint: false) ~> split1@(DatawithSalesID, DatawithID)",
				"select1 derive(Quantity = iif(isNull(Quantity_30), iif(isNull(Quantity_60), Quantity_73, Quantity_60), Quantity_30)) ~> derivedColumnForValue3andcategory",
				"split1@DatawithID select(mapColumn(",
				"          SaleID = id,",
				"          CustomerID = value1,",
				"          ProductID = value2,",
				"          SaleDate = date,",
				"          Quantity_30 = Quantity,",
				"          Quantity_60 = value3,",
				"          Quantity_73 = category,",
				"          TotalAmount = amount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumnForValue3andcategory select(mapColumn(",
				"          SaleID,",
				"          CustomerID,",
				"          ProductID,",
				"          SaleDate,",
				"          Quantity,",
				"          TotalAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, selectforsalesID union(byName: true)~> union1",
				"split1@DatawithSalesID select(mapColumn(",
				"          CustomerID,",
				"          ProductID,",
				"          Quantity,",
				"          SaleDate,",
				"          SaleID,",
				"          TotalAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectforsalesID",
				"union1 aggregate(groupBy(SaleID),",
				"     each(match(name!='SaleID'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sort(asc(SaleID, true)) ~> sortbasedonSaleID",
				"sortbasedonSaleID derive(ProductID = toInteger(iif(isNull(ProductID), 0, toInteger(ProductID))),",
				"          SaleDate = iif(isNull(SaleDate), currentDate(), SaleDate),",
				"          TotalAmount = toDouble(iif(isNull(TotalAmount), 0, toInteger(TotalAmount)))) ~> RemovingNUll",
				"Productssource1 filter(not(isNull(ProductID))) ~> filterrowexists",
				"filterrowexists derive(Category = iif(isNull(Category), 'Miscellaneous', Category),",
				"          Price = iif(isNull(Price), 'Miscellaneous', Price)) ~> checkNullproduct",
				"checkNullproduct window(over(Category),",
				"     TotalQuantityByCategory = sum(toInteger(StockQuantity))) ~> window1",
				"window1 rank(desc(StockQuantity, true),",
				"     output(RankStock as long)) ~> rankbyQuantity",
				"rankbyQuantity, RemovingNUll join(toInteger(Productssource1@ProductID) == RemovingNUll@ProductID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> FinalJOin",
				"FinalJOin select(mapColumn(",
				"          ProductID = Productssource1@ProductID,",
				"          ProductName,",
				"          Category,",
				"          Price,",
				"          StockQuantity,",
				"          TotalQuantityByCategory,",
				"          RankStock,",
				"          ProductID = RemovingNUll@ProductID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> removingduplicates",
				"Customers filter(not(isNull(CustomerID))) ~> filteronlyexistingcustomers",
				"filteronlyexistingcustomers derive(Country = iif(isNull(Country), 'USA', Country),",
				"          Email = iif(isNull(Email), 'missingemail@email.com', Email),",
				"          Phone = iif(Phone == 'None', '(123) 000-0000', Phone)) ~> derivedColumn1",
				"selectforsalesID sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     preCommands: [],",
				"     postCommands: []) ~> sink1",
				"removingduplicates sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> Finalsink"
			]
		}
	}
}